<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture for StopPlace extraction and the Centroid/Location guard in StopPointPlugin.

  - SP1: canonical StopPlace with Centroid/Location/coords → emitted with (60.1, 10.1).
  - SP2: no direct Centroid/Location, but a child Quay has Centroid/Location/coords →
         emitted with the Quay's coords (any-ancestor scoped match + first-wins).
  - SP3: bare Location (no Centroid wrapper) → must NOT be emitted — the Centroid guard
         in StopPointPlugin refuses to capture coords outside a Centroid for StopPlace.
  - SP4: Name only inside alternativeNames/AlternativeName → "Alt-Name Stop" wins since
         any-ancestor first-match finds the nested Name.
-->
<PublicationDelivery xmlns="http://www.netex.org.uk/netex" version="1.0">
    <PublicationTimestamp>2026-04-13T10:00:00Z</PublicationTimestamp>
    <ParticipantRef>TST:Codespace:NSR</ParticipantRef>
    <dataObjects>
        <SiteFrame id="TST:SiteFrame:1" version="1">
            <stopPlaces>
                <StopPlace id="TST:StopPlace:1" version="1">
                    <Name>Canonical Stop</Name>
                    <Centroid>
                        <Location>
                            <Longitude>10.1</Longitude>
                            <Latitude>60.1</Latitude>
                        </Location>
                    </Centroid>
                    <TransportMode>bus</TransportMode>
                </StopPlace>
                <StopPlace id="TST:StopPlace:2" version="1">
                    <Name>Quay-Coords Stop</Name>
                    <quays>
                        <Quay id="TST:Quay:2a" version="1">
                            <Centroid>
                                <Location>
                                    <Longitude>20.2</Longitude>
                                    <Latitude>50.2</Latitude>
                                </Location>
                            </Centroid>
                        </Quay>
                    </quays>
                </StopPlace>
                <StopPlace id="TST:StopPlace:3" version="1">
                    <Name>Bare-Location Stop</Name>
                    <Location>
                        <Longitude>99.9</Longitude>
                        <Latitude>99.9</Latitude>
                    </Location>
                </StopPlace>
                <StopPlace id="TST:StopPlace:4" version="1">
                    <alternativeNames>
                        <AlternativeName>
                            <Name>Alt-Name Stop</Name>
                        </AlternativeName>
                    </alternativeNames>
                    <Centroid>
                        <Location>
                            <Longitude>30.3</Longitude>
                            <Latitude>40.4</Latitude>
                        </Location>
                    </Centroid>
                </StopPlace>
            </stopPlaces>
        </SiteFrame>
    </dataObjects>
</PublicationDelivery>
